{
  "rules": {
    "admins": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'eigenaar@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
      ".write": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'eigenaar@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
      "$key": {
        ".validate": "newData.child('email').isString() && newData.child('email').val().toLowerCase().replace('.', ',') == $key"
      }
    },
    "tournament": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase() == 'eigenaar@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).exists())"
    }
  }
}
